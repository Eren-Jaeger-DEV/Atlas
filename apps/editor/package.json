{
  "name": "@atlas/editor",
  "version": "0.1.0",
  "private": true,
  "description": "Your codebase. Fully mapped. A professional, architecture-aware IDE.",
  "author": {
    "name": "Eren-Jaeger-DEV",
    "email": "dev@atlas-studio.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eren-Jaeger-DEV/Atlas.git"
  },
  "main": "./electron-dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npx wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build": "npx cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" vite build && tsc -p tsconfig.electron.json",
    "launch": "electron .",
    "electron": "electron .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@atlas/agents": "workspace:*",
    "@atlas/core": "workspace:*",
    "@atlas/graph": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@types/dompurify": "^3.2.0",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^3.6.0",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.42.2",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.7",
    "monaco-editor": "^0.55.1",
    "monaco-languageclient": "^10.7.0",
    "node-pty": "^1.1.0",
    "prettier": "^3.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.4.4",
    "typescript-language-server": "^5.3.0",
    "vscode-ws-jsonrpc": "^3.5.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/styled-components": "^5.1.36",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "build": {
    "appId": "com.atlas.studio",
    "productName": "Atlas Studio",
    "executableName": "atlas-studio",
    "artifactName": "atlas-studio_${version}_${arch}.${ext}",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "deb": {
      "packageName": "atlas-studio"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "Eren-Jaeger-DEV <dev@atlas-studio.io>"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atlas Studio"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64"] }
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
